        {
          "id": "g01_i_ga",
          "title": "이/가",
          "subtitle": "Marks the subject of the sentence",
          "pattern": "Consonant ending → 이 / Vowel ending → 가",
          "meaning": "subject marker",
          "rule_boxes": [
            {
              "color": "red",
              "label": "Consonant ending → 이",
              "examples": [
                "수정 → 수정이 (ends in ㅇ)",
                "선생님 → 선생님이 (ends in ㅁ)",
                "가람 → 가람이 (ends in ㅁ)"
              ]
            },
            {
              "color": "blue",
              "label": "Vowel ending → 가",
              "examples": [
                "태오 → 태오가 (ends in ㅗ)",
                "리나 → 리나가 (ends in ㅏ)",
                "미래 → 미래가 (ends in ㅐ)"
              ]
            }
          ],
          "examples": [
            {
              "korean": "남자아이가 노래해요.",
              "english": "The boy sings.",
              "highlight": "가"
            },
            {
              "korean": "선생님이 책을 읽어요.",
              "english": "The teacher reads a book.",
              "highlight": "이"
            },
            {
              "korean": "강아지가 달려요.",
