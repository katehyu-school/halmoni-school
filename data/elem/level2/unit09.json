    "grammar": {
      "sections": [
        {
          "id": "g09_adjective",
          "title": "형용사",
          "subtitle": "Describing Words (Adjectives)",
          "pattern": "주어 + 형용사 (문장 끝에!)",
          "description": "In Korean, adjectives come at the END of the sentence — the opposite of English!",
          "examples": [
            {
              "korean": "코끼리가 커요.",
              "english": "The elephant is big.",
              "highlight": "커요"
            },
            {
              "korean": "피자가 맛있어요.",
              "english": "Pizza is delicious.",
              "highlight": "맛있어요"
            },
            {
              "korean": "거북이가 느려요.",
              "english": "The turtle is slow.",
              "highlight": "느려요"
            }
          ],
          "rule_boxes": [
            {
              "color": "blue",
              "label": "📘 순서: 주어 + 형용사! (Subject + Adjective — adjective at the end!)",
              "examples": [
                "코끼리가 커요.  (The elephant is big.)",
                "게임이 재미있어요.  (Games are fun.)",
                "뱀이 길어요.  (The snake is long.)"
              ]
            },
            {
              "color": "red",
              "label": "🔴 있어요 ↔ 없어요  (have/exist ↔ don't have/not)",
              "examples": [
                "재미있어요 ↔ 재미없어요  (fun ↔ boring)",
                "맛있어요 ↔ 맛없어요  (delicious ↔ not tasty)"
              ]
            },
            {
              "color": "green",
              "label": "✅ 반대말! Opposite pairs",
              "examples": [
                "커요 ↔ 작아요  (big ↔ small)",
                "빨라요 ↔ 느려요  (fast ↔ slow)",
                "길어요 ↔ 짧아요  (long ↔ short)",
                "많아요 ↔ 적어요  (many ↔ few)"
              ]
            }
          ]
        }
      ]
    },
